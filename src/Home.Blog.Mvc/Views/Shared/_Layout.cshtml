<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#faf9f7">
    <title>@ViewData["Title"]</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,700&family=Inter:wght@400;500;600&display=swap">

    <link rel="stylesheet" href="~/assets/css/style.min.css" asp-append-version="true">

    @RenderSection("head", required: false)
</head>

<body>
    <a class="skip-link" href="#main">Skip to main content</a>

    <header class="site-header">
        <div class="container site-header__inner">
            <a class="brand" href="~/">Josh &amp; Shannon</a>

            <button class="nav-toggle" type="button" data-nav-toggle
                    aria-expanded="false" aria-controls="site-nav" aria-label="Toggle navigation">
                <span class="nav-toggle__bars" aria-hidden="true"></span>
            </button>

            @* Piranha sitemap-driven navigation — editable via the Manager *@
            <nav class="site-nav" id="site-nav" data-site-nav aria-label="Main navigation">
                <ul>
                    @foreach (var item in (await WebApp.Site.Sitemap.ForUserAsync(User, Auth)).Where(i => !i.IsHidden))
                    {
                        var isCurrent = item.Id == WebApp.PageId || item.HasChild(WebApp.PageId);
                        <li>
                            <a href="@WebApp.Url(item)" aria-current="@(isCurrent ? "page" : null)">@item.MenuTitle</a>
                        </li>
                    }
                </ul>
            </nav>
        </div>
    </header>

    <main class="site-main" id="main">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container site-footer__inner">
            <p>Josh &amp; Shannon — stories worth telling, moments worth sharing.</p>
            <p>&copy; @DateTime.Now.Year All rights reserved.</p>
        </div>
    </footer>

    <script src="~/assets/js/site.js" asp-append-version="true" defer></script>
</body>
</html>