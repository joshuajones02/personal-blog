<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#0f766e">
    <title>@ViewData["Title"]</title>

    <link rel="preload" href="~/assets/fonts/public-sans-latin.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="~/assets/fonts/fraunces-latin.woff2" as="font" type="font/woff2" crossorigin>

    <link rel="stylesheet" href="~/assets/css/style.min.css" asp-append-version="true">

    @RenderSection("head", required: false)
</head>

<body>
    <a class="skip-link" href="#main-content">Skip to main content</a>

    <partial name="Partials/_SiteHeader" />

    <main id="main-content" tabindex="-1">
        @RenderBody()
    </main>

    <partial name="Partials/_SiteFooter" />

    <script src="~/assets/js/site.js" asp-append-version="true" defer></script>
    @RenderSection("scripts", required: false)
</body>

</html>
