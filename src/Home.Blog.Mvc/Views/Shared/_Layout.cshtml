@{
    var sitemap = (await WebApp.Site.Sitemap.ForUserAsync(User, Auth)).Where(i => !i.IsHidden).ToList();
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#0b0b0c">
    <title>@ViewData["Title"]</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap">

    <link rel="stylesheet" href="~/assets/css/style.min.css" asp-append-version="true">

    @RenderSection("head", required: false)
</head>
<body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-nav" id="site-nav" data-open="false">
        <div class="container site-nav__inner">
            <a class="site-nav__brand" href="~/" aria-label="Josh & Shannon — home">
                <span class="brand-dot">·</span>Josh &amp; Shannon
                <span class="brand-tag">Travels</span>
            </a>

            <button class="site-nav__toggle"
                    type="button"
                    aria-controls="site-nav-menu"
                    aria-expanded="false"
                    aria-label="Toggle navigation menu"
                    data-nav-toggle>
                <span class="toggle-bar" aria-hidden="true"></span>
            </button>

            <nav aria-label="Primary">
                <ul class="site-nav__menu" id="site-nav-menu">
                    @foreach (var item in sitemap)
                    {
                        var isActive = item.Id == WebApp.PageId || item.HasChild(WebApp.PageId);
                        <li>
                            <a class="site-nav__link"
                               href="@WebApp.Url(item)"
                               @(isActive ? "aria-current=page" : "")>
                                @item.MenuTitle
                            </a>
                        </li>
                    }
                </ul>
            </nav>
        </div>
    </header>

    <main id="main" class="site-main" tabindex="-1">
        @RenderBody()
    </main>

    <footer class="site-footer" role="contentinfo">
        <div class="container">
            <div class="footer-grid">
                <div class="footer-brand">
                    <h2>
                        <span class="brand-dot">·</span>Josh &amp; Shannon
                    </h2>
                    <p>Stories worth telling. Moments worth sharing — long-form notes from the road.</p>
                </div>
                <div class="footer-meta">
                    <a href="~/">Home</a>
                    <span>&copy; @DateTime.Now.Year — All rights reserved.</span>
                </div>
            </div>
            <div class="footer-rule" role="presentation"></div>
            <div class="footer-meta" style="opacity:.7">
                <span>Crafted with care.</span>
            </div>
        </div>
    </footer>

    <script src="~/assets/js/site.js" asp-append-version="true" defer></script>
    @RenderSection("scripts", required: false)
</body>
</html>
