@{
    Layout = null;
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#0b0b0c">
    <title>Welcome to Piranha CMS</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap">

    <link rel="stylesheet" href="~/assets/css/style.min.css" asp-append-version="true">
</head>
<body class="setup">
    <main class="setup__card">
        <div class="setup__brand">
            <img src="https://piranhacms.org/assets/twitter-shield.png" alt="">
        </div>

        <h1 class="setup__title">Welcome to Piranha CMS</h1>

        <p class="setup__lead">
            Thanks for choosing the <strong>MVC Web Template</strong>. Let's get you set up.
        </p>

        <div class="setup__body">
            <p>
                Sign in to the admin panel at <code><a href="~/manager">~/manager</a></code>
                with the credentials <code>admin</code> / <code>password</code>.
            </p>
            <p>
                Want a quick tour? Seed example content to explore the CMS — you can remove the
                <code>SetupController</code> and the <code>~/seed</code> directory whenever you're ready.
            </p>
        </div>

        <div class="setup__actions">
            <a href="@Url.Action("Seed")"   class="btn btn-primary">Seed example data</a>
            <a href="~/manager/login"        class="btn btn-secondary">Open manager</a>
        </div>
    </main>
</body>
</html>
