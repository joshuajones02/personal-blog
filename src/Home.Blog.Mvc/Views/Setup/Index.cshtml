@{
    Layout = null;
}
<!doctype html>
<html lang="en">
<head>
    <!-- Required meta tags -->
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#0d9488">

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Caveat:wght@600;700&family=DM+Serif+Display:ital@0;1&family=Source+Sans+3:wght@300;400;500;600;700&display=swap">

    <style>
        :root {
            --teal: #0d9488;
            --teal-dark: #0f766e;
            --teal-light: #2dd4bf;
            --sunset: #f59e0b;
            --sunset-dark: #d97706;
            --coral: #f43f5e;
            --dark: #1c1917;
            --dark-soft: #44403c;
            --cream: #fefce8;
            --sand: #fef3c7;
            --light: #fafaf9;
            --gray: #78716c;
            --gray-light: #e7e5e4;
        }

        * {
            box-sizing: border-box;
        }

        body {
            background: linear-gradient(135deg, var(--cream) 0%, var(--sand) 100%);
            font-family: 'Source Sans 3', -apple-system, BlinkMacSystemFont, sans-serif;
            min-height: 100vh;
            display: flex;
            align-items: center;
            -webkit-font-smoothing: antialiased;
            position: relative;
            overflow-x: hidden;
            padding: 2rem 0;
        }

        /* Decorative background pattern */
        body::before {
            content: '';
            position: fixed;
            top: 0;
            right: 0;
            width: 50%;
            height: 100%;
            background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%230d9488' fill-opacity='0.06'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
            opacity: 0.7;
            pointer-events: none;
        }

        h2 {
            font-family: 'DM Serif Display', Georgia, serif;
            font-weight: 400;
            color: var(--dark);
            margin: 1.5rem 0 1rem;
            font-size: 2.25rem;
            line-height: 1.2;
        }

        code {
            font-family: 'JetBrains Mono', 'Fira Code', monospace;
            font-size: 0.85em;
            margin: 0 0.15rem;
            padding: 0.2rem 0.5rem;
            background: rgba(13, 148, 136, 0.1);
            color: var(--teal-dark);
            border-radius: 0.375rem;
        }

        a {
            color: var(--teal);
            text-decoration: none;
            transition: color 0.3s ease;
        }
        a:hover {
            color: var(--teal-dark);
        }

        p {
            color: var(--gray);
            line-height: 1.8;
            margin-bottom: 1rem;
            font-size: 1.05rem;
        }

        .lead {
            font-size: 1.15rem;
            color: var(--dark-soft);
            font-weight: 400;
        }

        strong {
            color: var(--dark-soft);
            font-weight: 600;
        }

        img {
            width: 56px;
            height: 56px;
            object-fit: contain;
        }

        .logo-wrapper {
            width: 88px;
            height: 88px;
            background: var(--teal);
            border-radius: 1rem;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 0.5rem;
            box-shadow: 0 10px 30px rgba(13, 148, 136, 0.3);
            position: relative;
        }

        .logo-wrapper img {
            filter: brightness(0) invert(1);
        }

        .card {
            border: 0 none;
            border-radius: 1.25rem;
            box-shadow: 0 20px 50px rgba(28, 25, 23, 0.1);
            animation: fadeInUp 0.6s ease;
            background: rgba(255, 255, 255, 0.95);
            position: relative;
            overflow: hidden;
        }

        .card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 5px;
            background: linear-gradient(90deg, var(--teal), var(--sunset));
        }

        .btn {
            font-family: 'Source Sans 3', sans-serif;
            font-weight: 600;
            padding: 0.875rem 1.75rem;
            border-radius: 0.5rem;
            font-size: 0.9rem;
            letter-spacing: 0.02em;
            transition: all 0.3s ease;
            border: none;
            position: relative;
        }

        .btn-primary {
            background: var(--teal);
            color: #fff;
            box-shadow: 0 4px 15px rgba(13, 148, 136, 0.25);
        }
        .btn-primary:hover {
            background: var(--teal-dark);
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(13, 148, 136, 0.35);
        }
        .btn-primary:active {
            transform: translateY(0);
        }

        .btn-accent {
            background: linear-gradient(135deg, var(--sunset) 0%, var(--sunset-dark) 100%);
            color: #fff;
            box-shadow: 0 4px 15px rgba(245, 158, 11, 0.25);
        }
        .btn-accent:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(245, 158, 11, 0.35);
        }

        .handwritten {
            font-family: 'Caveat', cursive;
            font-size: 1.1em;
            color: var(--teal);
        }

        @@keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
    </style>

    <title>Welcome to Piranha CMS</title>
</head>
<body>
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-5 col-md-7 col-sm-11 text-center">
                <div class="card p-4 p-md-5">
                    <div class="card-body">
                        <div class="logo-wrapper">
                            <img src="https://piranhacms.org/assets/twitter-shield.png" alt="Piranha CMS">
                        </div>
                        <h2>Welcome to Piranha CMS</h2>
                        <p class="lead">
                            Thanks for choosing our <strong>Web Template</strong> for MVC. 
                            <span class="handwritten">Let's get started!</span>
                        </p>
                        <p>
                            Log into the admin panel at <code><a href="~/manager">~/manager</a></code>
                            with credentials <code>admin/password</code>.
                        </p>
                        <p>
                            Want to see it in action? We can seed example content to help you explore 
                            Piranha CMS features. You can remove the <code>SetupController</code>
                            and <code>~/seed</code> directory when you're ready.
                        </p>
                        <div class="d-flex flex-wrap justify-content-center gap-3 mt-4">
                            <a href="@Url.Action("Seed")" class="btn btn-primary">Seed Example Data</a>
                            <a href="~/manager/login" class="btn btn-accent">Open Manager</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>