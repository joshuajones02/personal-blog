@{
    Layout = null;
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#faf9f7">
    <title>Welcome to Piranha CMS</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&family=Inter:wght@400;500;600&display=swap">

    <style>
        :root {
            --ink: #1c1917;
            --ink-soft: #44403c;
            --muted: #78716c;
            --paper: #faf9f7;
            --line: #e7e5e4;
            --accent: #b45309;
            --accent-strong: #92400e;
            --accent-soft: #fef3e2;
        }

        *, *::before, *::after { box-sizing: border-box; margin: 0; }

        body {
            min-height: 100dvh;
            display: grid;
            place-items: center;
            padding: 2rem 1.25rem;
            background: var(--paper);
            color: var(--ink-soft);
            font-family: 'Inter', system-ui, sans-serif;
            line-height: 1.7;
            -webkit-font-smoothing: antialiased;
        }

        .card {
            max-width: 34rem;
            padding: 3rem 2.5rem;
            background: #fff;
            border: 1px solid var(--line);
            border-radius: 1.25rem;
            box-shadow: 0 12px 32px rgb(28 25 23 / 0.12);
            text-align: center;
        }

        h1 {
            font-family: 'Fraunces', Georgia, serif;
            font-size: 2rem;
            color: var(--ink);
            margin-bottom: 1rem;
        }

        p { margin-bottom: 1rem; color: var(--muted); }

        code {
            padding: 0.15rem 0.4rem;
            background: var(--accent-soft);
            color: var(--accent-strong);
            border-radius: 0.375rem;
            font-size: 0.9em;
        }

        a { color: var(--accent); }
        a:focus-visible { outline: 3px solid #1d4ed8; outline-offset: 2px; }

        .actions {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 0.75rem;
            margin-top: 1.5rem;
        }

        .btn {
            display: inline-block;
            padding: 0.75rem 1.5rem;
            border-radius: 999px;
            font-weight: 600;
            font-size: 0.9rem;
            text-decoration: none;
            transition: background 200ms ease;
        }

        .btn--primary { background: var(--ink); color: var(--paper); }
        .btn--primary:hover { background: var(--accent-strong); }
        .btn--ghost { border: 1px solid var(--line); color: var(--ink); }
        .btn--ghost:hover { border-color: var(--accent); color: var(--accent-strong); }
    </style>
</head>
<body>
    <main class="card">
        <h1>Welcome to Piranha CMS</h1>
        <p>
            Thanks for choosing the Fable theme. Log into the admin panel at
            <code><a href="~/manager">~/manager</a></code> with credentials <code>admin/password</code>.
        </p>
        <p>
            Want to see it in action? Seed example content to explore Piranha CMS features.
            You can remove the <code>SetupController</code> and <code>~/seed</code> directory when you're ready.
        </p>
        <div class="actions">
            <a href="@Url.Action("Seed")" class="btn btn--primary">Seed example data</a>
            <a href="~/manager/login" class="btn btn--ghost">Open Manager</a>
        </div>
    </main>
</body>
</html>
