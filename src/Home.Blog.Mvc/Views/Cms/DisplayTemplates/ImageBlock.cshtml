@model Piranha.Extend.Blocks.ImageBlock

<figure class="block-image">
    <img src="@Url.Content(WebApp.Media.ResizeImage(Model, 1110))" alt="@(Model.Body.Media?.AltText ?? Model.Body.Media?.Title ?? string.Empty)" loading="lazy">
    @if (!string.IsNullOrWhiteSpace(Model.Body.Media?.Description))
    {
        <figcaption>@Model.Body.Media.Description</figcaption>
    }
</figure>