@model Piranha.Extend.Blocks.PageBlock

@if (Model.Body.Page != null)
{
    <a class="card" href="@WebApp.Url(Model)" aria-label="@Model.Body.Page.Title">
        @if (Model.Body.Page.PrimaryImage.HasValue)
        {
            <div class="card__media">
                <img src="@Url.Content(WebApp.Media.ResizeImage(Model.Body.Page.PrimaryImage, 720, 460))"
                     alt="@Model.Body.Page.Title"
                     loading="lazy"
                     decoding="async">
            </div>
        }
        <div class="card__body">
            <h3 class="card__title">@Model.Body.Page.Title</h3>
            @if (!string.IsNullOrWhiteSpace(Model.Body.Page.Excerpt))
            {
                <div class="card__excerpt">@Html.Raw(Model.Body.Page.Excerpt)</div>
            }
            <span class="card__footer read-more">Learn more</span>
        </div>
    </a>
}
