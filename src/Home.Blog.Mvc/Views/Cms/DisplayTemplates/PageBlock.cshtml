@model Piranha.Extend.Blocks.PageBlock

@if (Model.Body.Page != null)
{
    <a href="@WebApp.Url(Model)" class="card h-100 text-decoration-none card-link">
        @if (Model.Body.Page.PrimaryImage.HasValue)
        {
            <div class="card-img-wrapper">
                <img class="card-img-top" src="@Url.Content(WebApp.Media.ResizeImage(Model.Body.Page.PrimaryImage, 540, 300))" alt="@(Model.Body.Page.PrimaryImage.Media?.AltText ?? Model.Body.Page.Title)" loading="lazy">
            </div>
        }
        <div class="card-body d-flex flex-column">
            <h5 class="card-title">@Model.Body.Page.Title</h5>
            <p class="card-text flex-grow-1">@Html.Raw(Model.Body.Page.Excerpt)</p>
            <span class="read-more mt-auto">Learn More</span>
        </div>
    </a>
}