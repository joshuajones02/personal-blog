@model Piranha.Extend.Blocks.PageBlock
@if (Model.Body != null && Model.Body.Page != null)
{
    var target = Model.Body.Page;

    <a class="card-link" href="@target.Permalink">
        @if (target.PrimaryImage.HasValue)
        {
            <div class="card-link__media">
                <img src="@Url.Content(WebApp.Media.ResizeImage(target.PrimaryImage, 540, 304))"
                     srcset="@Url.Content(WebApp.Media.ResizeImage(target.PrimaryImage, 540, 304)) 540w,
                             @Url.Content(WebApp.Media.ResizeImage(target.PrimaryImage, 960, 540)) 960w"
                     sizes="(min-width: 48em) 24rem, calc(100vw - 2.5rem)"
                     alt="@(target.PrimaryImage.Media?.AltText ?? "")"
                     loading="lazy"
                     decoding="async">
            </div>
        }
        <div class="card-link__body">
            <h3 class="card-link__title">@target.Title</h3>
            @if (!string.IsNullOrWhiteSpace(target.Excerpt))
            {
                <p class="card-link__excerpt">@Html.Raw(target.Excerpt)</p>
            }
            <span class="read-more">Learn more<span class="visually-hidden"> about @target.Title</span></span>
        </div>
    </a>
}
