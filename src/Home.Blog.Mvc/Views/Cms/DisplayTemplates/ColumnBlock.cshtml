@model Piranha.Extend.Blocks.ColumnBlock
@{
    var count = Math.Max(1, Model.Items.Count);
}

<div class="block-columns" style="--col-count: @count">
    @foreach (var item in Model.Items)
    {
        <div class="block-columns__col">
            @Html.DisplayFor(m => item, item.GetType().Name)
        </div>
    }
</div>
