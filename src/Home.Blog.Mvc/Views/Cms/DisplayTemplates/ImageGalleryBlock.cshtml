@model Piranha.Extend.Blocks.ImageGalleryBlock
@using Piranha.Extend.Blocks
@{
    var images = Model.Items
        .OfType<ImageBlock>()
        .Where(i => i.Body.HasValue)
        .ToList();
}
@if (images.Count > 0)
{
    <div class="gallery" role="group" aria-roledescription="carousel" aria-label="Image gallery">
        <button type="button" class="gallery__control gallery__control--prev" hidden>
            <span aria-hidden="true">&larr;</span>
            <span class="visually-hidden">Previous images</span>
        </button>
        <ul class="gallery__track">
            @for (var n = 0; n < images.Count; n++)
            {
                var media = images[n].Body.Media;
                <li class="gallery__item" aria-label="@(n + 1) of @images.Count">
                    <img src="@Url.Content(WebApp.Media.ResizeImage(images[n].Body.Media, 768, 512))"
                         srcset="@Url.Content(WebApp.Media.ResizeImage(images[n].Body.Media, 480, 320)) 480w,
                                 @Url.Content(WebApp.Media.ResizeImage(images[n].Body.Media, 768, 512)) 768w,
                                 @Url.Content(WebApp.Media.ResizeImage(images[n].Body.Media, 1104, 736)) 1104w"
                         sizes="(min-width: 48em) 38rem, calc(100vw - 2.5rem)"
                         width="768"
                         height="512"
                         alt="@(media?.AltText ?? media?.Title)"
                         loading="lazy"
                         decoding="async">
                </li>
            }
        </ul>
        <button type="button" class="gallery__control gallery__control--next" hidden>
            <span aria-hidden="true">&rarr;</span>
            <span class="visually-hidden">Next images</span>
        </button>
    </div>
}
