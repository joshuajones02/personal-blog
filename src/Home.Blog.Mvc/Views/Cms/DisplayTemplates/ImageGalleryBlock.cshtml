@model Piranha.Extend.Blocks.ImageGalleryBlock
@using Piranha.Extend.Blocks
@{
    var unique = "gallery-" + Guid.NewGuid().ToString("N");
    var images = Model.Items
        .OfType<ImageBlock>()
        .Where(i => i.Body.HasValue)
        .ToList();
}

@if (images.Count > 0)
{
    <div id="@unique" class="gallery" data-gallery aria-roledescription="carousel" aria-label="Image gallery">
        <div class="gallery__viewport">
            @for (var n = 0; n < images.Count; n++)
            {
                var img = images[n];
                var alt = img.Body.Media?.AltText ?? "";
                <div class="gallery__slide"
                     data-active="@(n == 0 ? "true" : "false")"
                     role="group"
                     aria-roledescription="slide"
                     aria-label="Slide @(n + 1) of @images.Count"
                     @(n != 0 ? "aria-hidden=true" : "")>
                    <img src="@Url.Content(WebApp.Media.ResizeImage(img.Body.Media, 1280, 720))"
                         alt="@alt"
                         loading="@(n == 0 ? "eager" : "lazy")"
                         decoding="async">
                </div>
            }
        </div>

        @if (images.Count > 1)
        {
            <div class="gallery__controls" aria-hidden="false">
                <button type="button" class="gallery__btn" data-gallery-prev aria-label="Previous slide">
                    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"
                         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M10 12 6 8l4-4" />
                    </svg>
                </button>
                <button type="button" class="gallery__btn" data-gallery-next aria-label="Next slide">
                    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"
                         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="m6 4 4 4-4 4" />
                    </svg>
                </button>
            </div>

            <div class="gallery__indicators" role="tablist" aria-label="Select slide">
                @for (var n = 0; n < images.Count; n++)
                {
                    <button type="button"
                            data-gallery-goto="@n"
                            role="tab"
                            aria-label="Go to slide @(n + 1)"
                            aria-current="@(n == 0 ? "true" : "false")"></button>
                }
            </div>
        }
    </div>
}
