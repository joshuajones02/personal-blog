@model Piranha.Extend.Blocks.ImageGalleryBlock
@using Piranha.Extend.Blocks
@{
    var images = Model.Items
        .Where(i => i.GetType() == typeof(ImageBlock) && ((ImageBlock)i).Body.HasValue)
        .Cast<ImageBlock>()
        .ToList();
}

@* CSS scroll-snap gallery — swipe/scroll horizontally, no JS required *@
<div class="block-gallery" role="group" aria-label="Image gallery, @images.Count images">
    <div class="block-gallery__track" tabindex="0">
        @foreach (var item in images)
        {
            <figure class="block-gallery__item">
                <img src="@Url.Content(WebApp.Media.ResizeImage(item.Body.Media, 960, 640))"
                     alt="@(item.Body.Media?.AltText ?? item.Body.Media?.Title ?? string.Empty)" loading="lazy">
            </figure>
        }
    </div>
</div>
