@model Piranha.Extend.Blocks.PostBlock

@if (Model.Body.Post != null)
{
    <a class="card" href="@WebApp.Url(Model)" aria-label="@Model.Body.Post.Title">
        @if (Model.Body.Post.PrimaryImage.HasValue)
        {
            <div class="card__media">
                <img src="@Url.Content(WebApp.Media.ResizeImage(Model.Body.Post.PrimaryImage, 720, 460))"
                     alt="@Model.Body.Post.Title"
                     loading="lazy"
                     decoding="async">
            </div>
        }
        <div class="card__body">
            <h3 class="card__title">@Model.Body.Post.Title</h3>
            @if (!string.IsNullOrWhiteSpace(Model.Body.Post.Excerpt))
            {
                <div class="card__excerpt">@Html.Raw(Model.Body.Post.Excerpt)</div>
            }
            <span class="card__footer read-more">Read article</span>
        </div>
    </a>
}
