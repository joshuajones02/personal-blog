@model Piranha.Extend.Blocks.PostBlock

@if (Model.Body.Post != null)
{
    <article class="block-ref">
        @if (Model.Body.Post.PrimaryImage.HasValue)
        {
            <div class="block-ref__media">
                <img src="@Url.Content(WebApp.Media.ResizeImage(Model.Body.Post.PrimaryImage, 640, 420))" alt="" loading="lazy">
            </div>
        }
        <div class="block-ref__body">
            <h3 class="block-ref__title"><a href="@WebApp.Url(Model)">@Model.Body.Post.Title</a></h3>
            <p>@Html.Raw(Model.Body.Post.Excerpt)</p>
        </div>
    </article>
}
