@model Piranha.Models.Comment

<article class="comment">
    <div class="comment__avatar">
        <img src="@WebApp.GetGravatarUrl(Model.Email, 96)"
             alt=""
             width="48"
             height="48"
             loading="lazy"
             decoding="async">
    </div>
    <div class="comment__content">
        <header class="comment__head">
            <span class="comment__author">
                @if (!string.IsNullOrEmpty(Model.Url))
                {
                    <a href="@Model.Url" target="_blank" rel="noopener noreferrer ugc">@Model.Author</a>
                }
                else
                {
                    @Model.Author
                }
            </span>
            <time class="comment__date" datetime="@Model.Created.ToString("yyyy-MM-ddTHH:mm:ssZ")">
                @Model.Created.ToString("MMM d, yyyy")
            </time>
        </header>
        <p class="comment__body">@Model.Body</p>
    </div>
</article>
