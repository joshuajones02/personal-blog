@model Piranha.Models.Comment

<div class="comment">
    <div class="row align-items-start g-3">
        <div class="col-auto">
            <img class="rounded" src="@WebApp.GetGravatarUrl(Model.Email, 80)" alt="@Model.Author" width="50" height="50">
        </div>
        <div class="col">
            @if (!string.IsNullOrEmpty(Model.Url))
            {
                <h5><a href="@Model.Url" target="_blank" rel="noopener">@Model.Author</a> <small>@Model.Created.ToString("MMM d, yyyy")</small></h5>
            }
            else
            {
                <h5>@Model.Author <small>@Model.Created.ToString("MMM d, yyyy")</small></h5>
            }
            <p>@Model.Body</p>
        </div>
    </div>
</div>
