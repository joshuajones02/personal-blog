@model Piranha.Models.Comment

<article class="comment">
    <img class="comment__avatar" src="@WebApp.GetGravatarUrl(Model.Email, 96)" alt="" width="48" height="48" loading="lazy">
    <div>
        <p class="comment__author">
            @if (!string.IsNullOrEmpty(Model.Url))
            {
                <a href="@Model.Url" target="_blank" rel="noopener">@Model.Author</a>
            }
            else
            {
                @Model.Author
            }
            <time class="comment__date" datetime="@Model.Created.ToString("yyyy-MM-dd")">@Model.Created.ToString("MMM d, yyyy")</time>
        </p>
        <div class="comment__body">
            <p>@Model.Body</p>
        </div>
    </div>
</article>
