@model Piranha.Models.Comment

<article class="comment">
    <img class="comment__avatar" src="@WebApp.GetGravatarUrl(Model.Email, 96)" alt="" width="48" height="48" loading="lazy" decoding="async">
    <div class="comment__content">
        <header class="comment__meta">
            @if (!string.IsNullOrEmpty(Model.Url))
            {
                <a class="comment__author" href="@Model.Url" target="_blank" rel="noopener">@Model.Author</a>
            }
            else
            {
                <span class="comment__author">@Model.Author</span>
            }
            <time class="comment__date" datetime="@Model.Created.ToString("yyyy-MM-dd")">@Model.Created.ToString("MMM d, yyyy")</time>
        </header>
        <p class="comment__body">@Model.Body</p>
    </div>
</article>
