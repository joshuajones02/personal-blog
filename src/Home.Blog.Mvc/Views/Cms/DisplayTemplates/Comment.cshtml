@model Piranha.Models.Comment

<div class="comment">
    <img src="@WebApp.GetGravatarUrl(Model.Email, 96)" alt="" width="48" height="48" loading="lazy">
    <div>
        <div class="comment-meta">
            @if (!string.IsNullOrEmpty(Model.Url))
            {
                <a class="comment-author" href="@Model.Url" target="_blank" rel="noopener">@Model.Author</a>
            }
            else
            {
                <span class="comment-author">@Model.Author</span>
            }
            <span> · @Model.Created.ToString("MMM d, yyyy")</span>
        </div>
        <p>@Model.Body</p>
    </div>
</div>
