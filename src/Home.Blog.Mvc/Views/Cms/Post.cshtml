@model StandardPost
@{
    ViewData["Title"] = !string.IsNullOrEmpty(Model.MetaTitle) ? Model.MetaTitle : Model.Title;
    var heroImage = Model.PrimaryImage.HasValue
        ? Url.Content(WebApp.Media.ResizeImage(Model.PrimaryImage, 1920, 800))
        : null;

    var archive = await WebApp.Api.Pages.GetByIdAsync(Model.BlogId);
    var archiveUrl = archive?.Permalink ?? "/";

    var meta = new Home.Blog.Mvc.Models.PostMetaModel
    {
        ShowCategory      = false, // category lives in the eyebrow
        PublishedDate     = Model.IsPublished ? Model.Published : null,
        CommentCount      = Model.CommentCount,
        CommentsAnchorUrl = "#comments"
    };

    // Build the comment form model, hydrating with any errors / repost values
    // that the controller stashed into TempData on a failed submission.
    var commentForm = new Home.Blog.Mvc.Models.CommentFormModel
    {
        PostId    = Model.Id,
        ActionUrl = $"{Model.Permalink}/comment"
    };
    var stashedJson = TempData["CommentFormState"] as string;
    if (!string.IsNullOrEmpty(stashedJson))
    {
        try
        {
            var stashed = System.Text.Json.JsonSerializer.Deserialize<Home.Blog.Mvc.Controllers.CmsController.StashedCommentFormState>(stashedJson);
            if (stashed != null)
            {
                commentForm.Author      = stashed.Author;
                commentForm.Email       = stashed.Email;
                commentForm.Url         = stashed.Url;
                commentForm.Body        = stashed.Body;
                commentForm.FieldErrors = stashed.FieldErrors ?? new Dictionary<string, string>();
                commentForm.FormErrors  = stashed.FormErrors ?? new List<string>();
            }
        }
        catch (System.Text.Json.JsonException) { /* ignore corrupt state */ }
    }
    var commentJustSubmitted = TempData["CommentFormSuccess"] as string == "1";
    commentForm.JustSubmitted = commentJustSubmitted;
}
@section head {
    @WebApp.MetaTags(Model)
}

@await Html.PartialAsync("_Hero", new Home.Blog.Mvc.Models.HeroModel
{
    Title       = Model.Title,
    Eyebrow     = Model.Category != null
                      ? new Home.Blog.Mvc.Models.HeroEyebrow
                        {
                            Label = Model.Category.Title,
                            Href  = $"{archiveUrl}/category/{Model.Category.Slug}"
                        }
                      : null,
    Lead        = Model.Excerpt,
    ImageUrl    = heroImage,
    Variant     = "article",
    MetaPartial = "_PostMeta",
    MetaModel   = meta,
    Tags        = Model.Tags?.AsEnumerable(),
    ArchiveUrl  = archiveUrl
})

<article class="container container-narrow">
    @foreach (var block in Model.Blocks)
    {
        <div class="block @block.CssName()">
            @Html.DisplayFor(m => block, block.GetType().Name)
        </div>
    }

    @if (Model.EnableComments)
    {
        <section id="comments" class="comments-section" aria-labelledby="comments-title">
            <h2 class="comments-section__title" id="comments-title">
                @if (Model.CommentCount == 0)
                {
                    <text>Comments</text>
                }
                else
                {
                    @($"{Model.CommentCount} {(Model.CommentCount == 1 ? "comment" : "comments")}")
                }
            </h2>

            @if (Model.IsCommentsOpen)
            {
                @if (commentForm.JustSubmitted)
                {
                    <div class="alert alert-success" role="status">
                        Thanks — your comment has been posted.
                    </div>
                }
                @await Html.PartialAsync("_CommentForm", commentForm)
            }
            else
            {
                <div class="alert alert-info">
                    Comments are closed for this post.
                </div>
            }

            @if (Model.Comments != null && Model.Comments.Any())
            {
                <ul class="comments-list">
                    @foreach (var comment in Model.Comments)
                    {
                        <li>@Html.DisplayFor(m => comment)</li>
                    }
                </ul>
            }
            else if (Model.IsCommentsOpen)
            {
                <p class="u-text-center" style="color: var(--slate-soft);">
                    Be the first to leave a comment.
                </p>
            }
        </section>
    }
</article>
