@model StandardPost
@{
    ViewData["Title"] = !string.IsNullOrEmpty(Model.MetaTitle) ? Model.MetaTitle : Model.Title;
    var archive = await WebApp.Api.Pages.GetByIdAsync(Model.BlogId);
}
@section head {
    @WebApp.MetaTags(Model)
}

<article>
    <header class="hero container">
        <a class="hero__eyebrow" href="@archive.Permalink/category/@Model.Category.Slug">@Model.Category.Title</a>
        <h1 class="hero__title">@Model.Title</h1>
        <p class="hero__meta">
            @if (Model.IsPublished)
            {
                <time datetime="@Model.Published.Value.ToString("yyyy-MM-dd")">@Model.Published.Value.ToString("MMMM d, yyyy")</time>
            }
            @if (Model.EnableComments && Model.CommentCount > 0)
            {
                <text> &middot; </text><a href="#comments">@Model.CommentCount @(Model.CommentCount == 1 ? "comment" : "comments")</a>
            }
        </p>
        @if (!string.IsNullOrWhiteSpace(Model.Excerpt))
        {
            <div class="hero__excerpt">@Html.Raw(Model.Excerpt)</div>
        }
        @if (Model.PrimaryImage.HasValue)
        {
            <div class="hero__image">
                <img src="@Url.Content(WebApp.Media.ResizeImage(Model.PrimaryImage, 1920, 820))" alt="@(Model.PrimaryImage.Media?.AltText ?? string.Empty)">
            </div>
        }
    </header>

    @* Piranha block content — each block renders via its DisplayTemplate *@
    <div class="blocks prose-width">
        @foreach (var block in Model.Blocks)
        {
            <div class="block @block.CssName()">
                @Html.DisplayFor(m => block, block.GetType().Name)
            </div>
        }
    </div>

    @if (Model.Tags.Any())
    {
        <div class="prose-width" style="margin-top: var(--sp-6);">
            <ul class="tag-list">
                @foreach (var tag in Model.Tags)
                {
                    <li><a class="tag" href="@archive.Permalink/tag/@tag.Slug">#@tag.Slug</a></li>
                }
            </ul>
        </div>
    }
</article>

@if (Model.EnableComments)
{
    <section id="comments" class="comments prose-width" aria-label="Comments">
        <h2>Comments</h2>

        @if (Model.IsCommentsOpen)
        {
            @* Posts to Piranha's comment endpoint — field names must match SaveCommentModel *@
            <form action="@Model.Permalink/comment" method="post">
                @Html.AntiForgeryToken()
                @Html.Hidden("Id", Model.Id)

                <h3>Leave a comment</h3>
                <p><small>Your email won't be shared publicly. We'll only use it for your Gravatar image.</small></p>

                <div class="form-grid">
                    <div class="form-field">
                        <label for="comment-author">Name</label>
                        <input id="comment-author" name="CommentAuthor" type="text" autocomplete="name" required>
                    </div>
                    <div class="form-field">
                        <label for="comment-email">Email</label>
                        <input id="comment-email" name="CommentEmail" type="email" autocomplete="email" required>
                    </div>
                </div>
                <div class="form-field">
                    <label for="comment-url">Website <small>(optional)</small></label>
                    <input id="comment-url" name="CommentUrl" type="url" autocomplete="url">
                </div>
                <div class="form-field">
                    <label for="comment-body">Comment</label>
                    <textarea id="comment-body" name="CommentBody" rows="5" required></textarea>
                </div>
                <button type="submit" class="btn btn--primary">Post comment</button>
            </form>
        }

        @Html.DisplayFor(m => m.Comments)
    </section>
}
