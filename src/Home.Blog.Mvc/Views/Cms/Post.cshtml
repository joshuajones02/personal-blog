@model StandardPost
@using System.Text.Json
@{
    ViewData["Title"] = !string.IsNullOrEmpty(Model.MetaTitle) ? Model.MetaTitle : Model.Title;

    var archive = await WebApp.Api.Pages.GetByIdAsync(Model.BlogId);
    var archivePermalink = archive?.Permalink ?? string.Empty;

    var hero = new HeroViewModel
    {
        Title = Model.Title,
        ExcerptHtml = Model.Excerpt,
        Image = Model.PrimaryImage,
        EyebrowText = Model.Category?.Title,
        EyebrowUrl = Model.Category != null ? $"{archivePermalink}/category/{Model.Category.Slug}" : null,
        Published = Model.IsPublished ? Model.Published : null,
        CommentCount = Model.CommentCount,
        ShowCommentCount = Model.EnableComments,
        Tags = Model.Tags
            .Select(t => new HeroLink(t.Slug, $"{archivePermalink}/tag/{t.Slug}"))
            .ToList()
    };

    // BlogPosting structured data. Serialized with System.Text.Json so
    // strings are safely escaped for inline <script> output.
    var origin = $"{Context.Request.Scheme}://{Context.Request.Host}";
    var jsonLd = new Dictionary<string, object>
    {
        ["@context"] = "https://schema.org",
        ["@type"] = "BlogPosting",
        ["headline"] = Model.Title,
        ["mainEntityOfPage"] = origin + Model.Permalink,
        ["author"] = new Dictionary<string, object>
        {
            ["@type"] = "Person",
            ["name"] = "Josh & Shannon"
        },
        ["publisher"] = new Dictionary<string, object>
        {
            ["@type"] = "Organization",
            ["name"] = "Josh & Shannon Travels"
        }
    };
    if (Model.IsPublished && Model.Published.HasValue)
    {
        jsonLd["datePublished"] = Model.Published.Value.ToString("yyyy-MM-dd");
    }
    if (!string.IsNullOrWhiteSpace(Model.Excerpt))
    {
        jsonLd["description"] = Model.Excerpt;
    }
    if (Model.PrimaryImage.HasValue)
    {
        jsonLd["image"] = origin + Url.Content(WebApp.Media.ResizeImage(Model.PrimaryImage, 1200));
    }
}
@section head {
    @WebApp.MetaTags(Model)
    <script type="application/ld+json">@Html.Raw(JsonSerializer.Serialize(jsonLd))</script>
}

<partial name="Partials/_PageHero" model="hero" />

<article class="post-article">
    @foreach (var block in Model.Blocks)
    {
        <div class="block @block.CssName()">
            <div class="container">
                @Html.DisplayFor(m => block, block.GetType().Name)
            </div>
        </div>
    }
</article>

@if (Model.EnableComments)
{
    <section id="comments" class="container comments" aria-label="Comments">
        <div class="comments__inner">
            <h2 class="comments__title">
                Comments
                @if (Model.CommentCount > 0)
                {
                    <span class="comments__count">(@Model.CommentCount)</span>
                }
            </h2>

            @if (Model.IsCommentsOpen)
            {
                <div class="comment-form">
                    <form action="@Model.Permalink/comment" method="post">
                        @Html.AntiForgeryToken()
                        @Html.Hidden("Id", Model.Id)

                        <h3>Leave a comment</h3>
                        <p class="comment-form__hint">
                            Your email won't be shared publicly. We'll only use it for your Gravatar image.
                        </p>

                        <div class="comment-form__grid">
                            <div class="form-field">
                                <label for="comment-author">Name</label>
                                <input id="comment-author" name="CommentAuthor" type="text" autocomplete="name" required>
                            </div>
                            <div class="form-field">
                                <label for="comment-email">Email</label>
                                <input id="comment-email" name="CommentEmail" type="email" autocomplete="email" required>
                            </div>
                            <div class="form-field form-field--wide">
                                <label for="comment-url">Website <span class="form-field__optional">(optional)</span></label>
                                <input id="comment-url" name="CommentUrl" type="url" autocomplete="url">
                            </div>
                            <div class="form-field form-field--wide">
                                <label for="comment-body">Comment</label>
                                <textarea id="comment-body" name="CommentBody" rows="5" required></textarea>
                            </div>
                        </div>

                        <div class="comment-form__actions">
                            <button type="submit" class="button">Post comment</button>
                        </div>
                    </form>
                </div>
            }

            @if (Model.Comments.Any())
            {
                <div class="comments__list">
                    @Html.DisplayFor(m => m.Comments)
                </div>
            }
            else
            {
                <p class="comments__empty">No comments yet — be the first to share your thoughts.</p>
            }
        </div>
    </section>
}
