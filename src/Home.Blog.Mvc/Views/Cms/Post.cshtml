@model StandardPost
@{
    ViewData["Title"] = !string.IsNullOrEmpty(Model.MetaTitle) ? Model.MetaTitle : Model.Title;
    var hasImage = Model.PrimaryImage.HasValue;
    var archive = await WebApp.Api.Pages.GetByIdAsync(Model.BlogId);
}
@section head {
    @WebApp.MetaTags(Model)
}

<header class="page-hero@(hasImage ? " has-image" : "")" @(hasImage ? $"style=background-image:url({ @Url.Content(WebApp.Media.ResizeImage(Model.PrimaryImage, 1920, 700)) })" : "")>
    <div class="dimmer"></div>
    <div class="container text-center">
        <a href="@archive.Permalink/category/@Model.Category.Slug" class="subheading">@Model.Category.Title</a>
        <h1>@Model.Title</h1>
        <p class="post-meta mb-3">
            @if (Model.IsPublished)
            {
                <span>
                    @Model.Published.Value.ToString("MMMM d, yyyy")
                </span>
            }
            @if (Model.EnableComments && Model.CommentCount > 0)
            {
                <span>
                    <a href="#comments">@Model.CommentCount @(Model.CommentCount == 1 ? "comment" : "comments")</a>
                </span>
            }
        </p>
        @if (!string.IsNullOrWhiteSpace(Model.Excerpt))
        {
            <div class="row justify-content-center">
                <div class="col-lg-8 lead">
                    @Html.Raw(Model.Excerpt)
                </div>
            </div>
        }
        @if (Model.Tags.Any())
        {
            <div class="mt-3">
                @foreach (var tag in Model.Tags)
                {
                    <a href="@archive.Permalink/tag/@tag.Slug" class="tag">#@tag.Slug</a>
                }
            </div>
        }
    </div>
</header>

<main>
    <article>
        @foreach (var block in Model.Blocks)
        {
            <div class="block @block.CssName()">
                <div class="container">
                    <div class="row justify-content-center">
                        <div class="col-lg-9">
                            @Html.DisplayFor(m => block, block.GetType().Name)
                        </div>
                    </div>
                </div>
            </div>
        }
    </article>
    @if (Model.EnableComments)
    {
        <section id="comments" class="container comments" aria-label="Comments">
            <div class="row justify-content-center">
                <div class="col-lg-9">
                    @if (Model.IsCommentsOpen)
                    {
                        <div class="alert alert-comment mt-2 mb-5">
                            <form action="@Model.Permalink/comment" method="post">
                                @Html.AntiForgeryToken()
                                @Html.Hidden("Id", Model.Id)

                                <h3>Leave a Comment</h3>
                                <p class="mb-4 text-muted">
                                    Your email won't be shared publicly. We'll only use it for your Gravatar image.
                                </p>
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <input name="CommentAuthor" type="text" class="form-control" placeholder="Your name" required>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <input name="CommentEmail" type="email" class="form-control" placeholder="Your email address" required>
                                    </div>
                                </div>
                                <div class="form-group mt-3">
                                    <input name="CommentUrl" type="url" class="form-control" placeholder="Website (optional)">
                                </div>
                                <div class="form-group mt-3">
                                    <textarea name="CommentBody" rows="5" class="form-control" placeholder="Share your thoughts..." required></textarea>
                                </div>
                                <div class="form-group text-start mt-3">
                                    <button class="btn btn-primary">Post Comment</button>
                                </div>
                            </form>
                        </div>
                    }
                    @Html.DisplayFor(m => m.Comments)
                </div>
            </div>
        </section>
    }
</main>
