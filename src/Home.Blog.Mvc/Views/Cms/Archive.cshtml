@model StandardArchive
@{
    ViewData["Title"] = !string.IsNullOrEmpty(Model.MetaTitle) ? Model.MetaTitle : Model.Title;

    var blogLink = Model.Permalink
        + (Model.Archive.Category != null ? $"/category/{Model.Archive.Category.Slug}" : "")
        + (Model.Archive.Year.HasValue ? $"/{Model.Archive.Year}" : "")
        + (Model.Archive.Month.HasValue ? $"/{Model.Archive.Month}" : "");

    var hero = new HeroViewModel
    {
        Title = Model.Title,
        ExcerptHtml = Model.Excerpt,
        Image = Model.PrimaryImage
    };

    var pagination = new PaginationViewModel
    {
        BaseUrl = blogLink,
        CurrentPage = Model.Archive.CurrentPage,
        TotalPages = Model.Archive.TotalPages
    };
}
@section head {
    @WebApp.MetaTags(Model)
}

<partial name="Partials/_PageHero" model="hero" />

<div class="archive">
    @foreach (var block in Model.Blocks)
    {
        <div class="block @block.CssName()">
            <div class="container">
                @Html.DisplayFor(m => block, block.GetType().Name)
            </div>
        </div>
    }

    <section class="container archive__posts" aria-label="Posts">
        @if (Model.Archive.Posts.Count > 0)
        {
            ViewData["CategoryBase"] = Model.Permalink;

            <div class="post-grid">
                @for (var i = 0; i < Model.Archive.Posts.Count; i++)
                {
                    var post = Model.Archive.Posts[i];

                    if (i == 0)
                    {
                        ViewData["Featured"] = true;
                        <div class="post-grid__featured">
                            <partial name="Partials/_PostCard" model="post" />
                        </div>
                        ViewData["Featured"] = false;
                    }
                    else
                    {
                        <partial name="Partials/_PostCard" model="post" />
                    }
                }
            </div>
        }
        else
        {
            <div class="archive__empty">
                <h2>No stories yet</h2>
                <p>We're busy planning the next adventure — check back soon.</p>
            </div>
        }

        <partial name="Partials/_Pagination" model="pagination" />
    </section>
</div>
