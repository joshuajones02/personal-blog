@model StandardArchive
@{
    ViewData["Title"] = !string.IsNullOrEmpty(Model.MetaTitle) ? Model.MetaTitle : Model.Title;

    Func<string> BlogLink = () => {
        return Model.Permalink
            + (Model.Archive.Category != null ? $"/category/{Model.Archive.Category.Slug}" : "")
            + (Model.Archive.Year.HasValue ? $"/{Model.Archive.Year}" : "")
            + (Model.Archive.Month.HasValue ? $"/{Model.Archive.Month}" : "");
    };
}
@section head {
    @WebApp.MetaTags(Model)
}

<header class="hero container">
    @if (Model.Archive.Category != null)
    {
        <span class="hero__eyebrow">@Model.Archive.Category.Title</span>
    }
    <h1 class="hero__title">@Model.Title</h1>
    @if (!string.IsNullOrWhiteSpace(Model.Excerpt))
    {
        <div class="hero__excerpt">@Html.Raw(Model.Excerpt)</div>
    }
</header>

@* Piranha block content on the archive page itself *@
@if (Model.Blocks.Any())
{
    <div class="blocks prose-width" style="margin-bottom: var(--sp-7);">
        @foreach (var block in Model.Blocks)
        {
            <div class="block @block.CssName()">
                @Html.DisplayFor(m => block, block.GetType().Name)
            </div>
        }
    </div>
}

<div class="container">
    <div class="card-grid">
        @foreach (var post in Model.Archive.Posts)
        {
            <article class="post-card">
                @if (post.PrimaryImage.HasValue)
                {
                    <div class="post-card__media">
                        <a href="@post.Permalink" tabindex="-1" aria-hidden="true">
                            <img src="@Url.Content(WebApp.Media.ResizeImage(post.PrimaryImage, 720, 405))" alt="@(post.PrimaryImage.Media?.AltText ?? string.Empty)" loading="lazy">
                        </a>
                    </div>
                }
                <div class="post-card__body">
                    <a class="post-card__category" href="@Model.Permalink/category/@post.Category.Slug">@post.Category.Title</a>
                    <h2 class="post-card__title"><a href="@post.Permalink">@post.Title</a></h2>
                    <div class="post-card__excerpt">@Html.Raw(post.Excerpt)</div>
                    <p class="post-card__meta">
                        @if (post.IsPublished)
                        {
                            <time datetime="@post.Published.Value.ToString("yyyy-MM-dd")">@post.Published.Value.ToString("MMMM d, yyyy")</time>
                        }
                        @if (post.EnableComments && post.CommentCount > 0)
                        {
                            <text> &middot; </text><a href="@post.Permalink#comments">@post.CommentCount @(post.CommentCount == 1 ? "comment" : "comments")</a>
                        }
                    </p>
                </div>
            </article>
        }
    </div>

    @if (Model.Archive.TotalPages > 1)
    {
        <nav class="pagination" aria-label="Archive pages">
            <ul>
                <li>
                    @if (Model.Archive.CurrentPage > 1)
                    {
                        <a href="@BlogLink()/page/@(Model.Archive.CurrentPage - 1)" rel="prev">&lsaquo;<span class="visually-hidden"> Previous page</span></a>
                    }
                    else
                    {
                        <span class="is-disabled" aria-hidden="true">&lsaquo;</span>
                    }
                </li>
                @for (var n = 1; n <= Model.Archive.TotalPages; n++)
                {
                    <li>
                        <a href="@BlogLink()/page/@n" aria-current="@(Model.Archive.CurrentPage == n ? "page" : null)">@n</a>
                    </li>
                }
                <li>
                    @if (Model.Archive.CurrentPage < Model.Archive.TotalPages)
                    {
                        <a href="@BlogLink()/page/@(Model.Archive.CurrentPage + 1)" rel="next">&rsaquo;<span class="visually-hidden"> Next page</span></a>
                    }
                    else
                    {
                        <span class="is-disabled" aria-hidden="true">&rsaquo;</span>
                    }
                </li>
            </ul>
        </nav>
    }
</div>
